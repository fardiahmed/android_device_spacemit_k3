package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

genrule {
    name: "gen_fstab_k3",
    srcs: ["fstab.in"],
    out: ["fstab.k3"],
    cmd: "sed 's/@boot_node@/c0e00000.ufshc/g' $(in) > $(out)",
}

prebuilt_etc {
    name: "fstab.k3",
    src: ":gen_fstab_k3",
    vendor: true,
    vendor_ramdisk_available: true,
}
