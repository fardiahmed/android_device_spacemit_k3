on early-init
    mount debugfs debugfs /sys/kernel/debug mode=0755
    # Run the cores at max frequency until boot completes (same as the K1). The K3 X100 cores
    # may expose one cpufreq policy per cluster; policy0 is the first cluster.
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor performance

on property:sys.boot_completed=1
    write /sys/devices/system/cpu/cpufreq/policy0/scaling_governor schedutil
    write /proc/sys/kernel/printk "7 4 1 7"
    write /proc/sys/kernel/printk_devkmsg on

on init
    symlink /sdcard /storage/sdcard0

on fs
    mount_all /vendor/etc/fstab.k3 --early

on late-fs
    mount_all /vendor/etc/fstab.k3 --late

on post-fs-data
    mkdir /data/vendor/wifi 0771 wifi wifi
    mkdir /data/vendor/wifi/wpa 0770 wifi wifi
    mkdir /data/vendor/wifi/wpa/sockets 0770 wifi wifi

# VPU driver (amvx_k3.ko): no modalias, load it explicitly.
on early-boot
    exec_background u:r:vendor_modprobe:s0 -- /vendor/bin/modprobe -d /vendor_dlkm/lib/modules amvx_k3

on boot
    # Miracast sink / any bursty UDP receiver: let apps ask for up to 8 MB of SO_RCVBUF
    # (see device/spacemit/k1/init.k1.rc).
    write /proc/sys/net/core/rmem_max 8388608
